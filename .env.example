# ATENÇÃO: este arquivo (.env.example) VAI para o GitHub. Nunca cole senha/chave aqui.
# Copie este arquivo para .env.local (esse sim é ignorado pelo git) e preencha os valores
# reais lá — de acordo com o seu projeto Supabase (Project Settings -> API, e o painel
# "Connect" -> ORM -> Drizzle para a DATABASE_URL).

# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings -> API -> Project API keys -> anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings -> API -> Project API keys -> service_role (secreta, só uso no servidor)
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings -> Database -> Connection string -> Transaction pooler (URI)
DATABASE_URL=