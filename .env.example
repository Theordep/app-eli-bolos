# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase
# (Project Settings -> API, e Project Settings -> Database -> Connection string).
# NUNCA commitar o .env.local (já está no .gitignore).

# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings -> API -> Project API keys -> anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings -> API -> Project API keys -> service_role (secreta, só uso no servidor)
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings -> Database -> Connection string -> Transaction pooler (URI)
DATABASE_URL=
